# ═══════════════════════════════════════════════════════════════════════════════
# Axiom Terminal - Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# SECURITY NOTICE:
# - This file contains template values. NEVER commit the actual .env to git
# - Add .env to .gitignore (already done in this project)
# - Keep your API keys confidential
# - Create a local copy: cp .env.example .env
# - Add your actual API keys to .env
#
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

APP_NAME=Axiom Terminal API
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════════════════════
# Development: SQLite
DATABASE_URL=sqlite:///./axiom.db
# Production: PostgreSQL example
# DATABASE_URL=postgresql://user:password@localhost/axiom_db

SQLALCHEMY_ECHO=False

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER & API
# ═══════════════════════════════════════════════════════════════════════════════

API_V1_STR=/api

# CORS Origins - Add your deployment URLs here for production
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════════════════════════════
# ⚠️  PRODUCTION: Generate a strong secret key using: python -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ═══════════════════════════════════════════════════════════════════════════════
# FINANCIAL DATA PROVIDER SELECTION
# ═══════════════════════════════════════════════════════════════════════════════
# Options: "mock" (for development) or "alpha_vantage", "fin_hub" (for real data)

MARKET_DATA_PROVIDER=mock
TECHNICAL_INDICATOR_PROVIDER=mock
FORECAST_PROVIDER=mock

# ═══════════════════════════════════════════════════════════════════════════════
# EXTERNAL API KEYS - MARKET DATA
# ═══════════════════════════════════════════════════════════════════════════════
# Get free API keys from: https://www.alphavantage.co/api
# Rate limit: 5 requests/min (free tier)

ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Get free API key from: https://fredaccount.stlouisfed.org/login
# Federal Reserve Economic Data
FRED_API_KEY=your_fred_api_key_here

# Get free API key from: https://finnhub.io
# Financial data aggregator
FIN_HUB_API_KEY=your_finhub_api_key_here

# Get free API key from: https://newsapi.org
# Financial news aggregation
NEWS_API_KEY=your_newsapi_key_here

# SEC EDGAR - For SEC filings data (currently optional)
SEC_API_KEY=your_sec_api_key_here
SEC_USER_AGENT=Axiom Terminal (contact: your.email@example.com)

# ═══════════════════════════════════════════════════════════════════════════════
# EXTERNAL API KEYS - AI/LLM
# ═══════════════════════════════════════════════════════════════════════════════
# Get free API key from: https://console.groq.com
# Rate limit: 30 requests/min (free tier)
# Model: mixtral-8x7b-32768 (fast open-source LLM)

GROQ_API_KEY=your_groq_api_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# ML & FORECASTING
# ═══════════════════════════════════════════════════════════════════════════════

USE_ML_FORECASTS=True
ML_MODEL_PATH=

# ═══════════════════════════════════════════════════════════════════════════════
# CACHING
# ═══════════════════════════════════════════════════════════════════════════════

USE_CACHE=True
CACHE_TTL_SECONDS=300

# ═══════════════════════════════════════════════════════════════════════════════
# FUTURE: EMAIL/NOTIFICATIONS
# ═══════════════════════════════════════════════════════════════════════════════

SMTP_SERVER=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
