# ═══════════════════════════════════════════════════════════════════════════════
# Axiom Terminal - Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# This is a template file. To set up your local environment:
#
# 1. Backend Setup:
#    cp backend/.env.example backend/.env
#    Edit backend/.env and add your actual API keys
#
# 2. Frontend Setup:
#    cp frontend/.env.local.example frontend/.env.local
#    Edit frontend/.env.local if needed (defaults are usually fine for development)
#
# SECURITY: Never commit .env files with actual secrets to version control
#
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# BACKEND CONFIGURATION - backend/.env
# ═══════════════════════════════════════════════════════════════════════════════

# Application
DEBUG=True
DATABASE_URL=sqlite:///./axiom.db

# Data Providers (use "mock" for development)
MARKET_DATA_PROVIDER=mock
TECHNICAL_INDICATOR_PROVIDER=mock
FORECAST_PROVIDER=mock

# External API Keys
# Get from: https://www.alphavantage.co/api
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Get from: https://fredaccount.stlouisfed.org/login
FRED_API_KEY=your_fred_api_key_here

# Get from: https://finnhub.io
FIN_HUB_API_KEY=your_finhub_api_key_here

# Get from: https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# Get from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: SEC API
SEC_API_KEY=your_sec_api_key_here
SEC_USER_AGENT=Axiom Terminal (contact: your.email@example.com)

# ═══════════════════════════════════════════════════════════════════════════════
# FRONTEND CONFIGURATION - frontend/.env.local
# ═══════════════════════════════════════════════════════════════════════════════

# Backend API URL for frontend
# Development (default): http://localhost:8000/api
# Production: Use your deployed backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ═══════════════════════════════════════════════════════════════════════════════
# FRONTEND CONFIGURATION - frontend/.env.local
# ═══════════════════════════════════════════════════════════════════════════════

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_DEBUG=true
