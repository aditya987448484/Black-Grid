# ═══════════════════════════════════════════════════════════════════════════════
# Axiom Terminal - Frontend Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# SECURITY NOTICE:
# - This file should ONLY contain public variables (prefixed with NEXT_PUBLIC_)
# - NEVER store secrets in frontend environment variables
# - Create a local copy: cp .env.local.example .env.local
# - .env.local is git-ignored and safe to keep secrets temporarily for development
# - Consider using separate .env.local.example for secrets reference only
#
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# API CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Backend API base URL - change based on environment
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ═══════════════════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# Application name - displayed in UI
NEXT_PUBLIC_APP_NAME=Axiom Terminal

# Application version - for version display
NEXT_PUBLIC_APP_VERSION=0.1.0

# Enable debug mode for development
NEXT_PUBLIC_DEBUG=true

# ═══════════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════════════════
# Enable/disable features in development
NEXT_PUBLIC_ENABLE_REAL_DATA=false
NEXT_PUBLIC_ENABLE_BACKTESTING=true
NEXT_PUBLIC_ENABLE_FORECASTING=true

# ═══════════════════════════════════════════════════════════════════════════════
# ANALYTICS & MONITORING
# ═══════════════════════════════════════════════════════════════════════════════
# Optional: Add your analytics IDs here (non-sensitive)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=
